<?xml version="1.0"?>
<sdf version="1.9">
  <world name="empty">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></visual>
      </link>
    </model>

    <!-- Стены -->
    <model name="wall_top">
      <static>true</static>
      <pose>5 9 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_bottom">
      <static>true</static>
      <pose>5 -1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_left">
      <static>true</static>
      <pose>-1 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_right_top">
      <static>true</static>
      <pose>11 8.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_right_bottom">
      <static>true</static>
      <pose>11 0.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Робот с JointController, цилиндры -->
    <model name="turtle">
      <pose>0 0 0.1 0 0 0</pose>

      <link name="chassis">
        <inertial><mass>15.0</mass><inertia><ixx>0.1</ixx><iyy>0.15</iyy><izz>0.2</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.3 0.2 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.2 0.1</size></box></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient></material>
        </visual>
      </link>

      <!-- Левое колесо (цилиндр, лежит на боку) -->
      <link name="wheel_left">
        <pose>0 0.11 -0.05 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>100.0</mu><mu2>100.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        </visual>
      </link>

      <!-- Правое колесо (цилиндр, лежит на боку) -->
      <link name="wheel_right">
        <pose>0 -0.11 -0.05 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>100.0</mu><mu2>100.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.02</length></cylinder></geometry>
        </visual>
      </link>

      <link name="caster">
        <pose>-0.1 0 -0.09 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.02</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.02</radius></sphere></geometry></visual>
      </link>

      <!-- Шарниры: ось Z (локальная ось цилиндра, после roll=-π/2 смотрит вдоль Y) -->
      <joint name="joint_left" type="revolute">
        <parent>chassis</parent><child>wheel_left</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="joint_right" type="revolute">
        <parent>chassis</parent><child>wheel_right</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="joint_caster" type="fixed">
        <parent>chassis</parent><child>caster</child>
      </joint>

      <!-- Контроллеры силы -->
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>joint_left</joint_name>
        <use_force_commands>true</use_force_commands>
        <p_gain>1.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.0</d_gain>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
        <topic>/model/turtle/joint/joint_left/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>joint_right</joint_name>
        <use_force_commands>true</use_force_commands>
        <p_gain>1.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.0</d_gain>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
        <topic>/model/turtle/joint/joint_right/cmd_vel</topic>
      </plugin>

      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/odom</odom_topic>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>chassis</robot_base_frame>
        <dimensions>2</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>